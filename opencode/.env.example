# CQL Studio OpenCode Runner Environment Variables (Development Defaults)
CQL_STUDIO_OPENCODE_NODE_ENV=development
CQL_STUDIO_OPENCODE_LOG_LEVEL=info

# Private runner HTTP API (gateway authenticates with the shared token)
CQL_STUDIO_OPENCODE_RUNNER_PORT=4097
CQL_STUDIO_OPENCODE_RUNNER_TOKEN=cql-studio-opencode-development-only

# Embedded opencode serve bind (loopback only)
CQL_STUDIO_OPENCODE_INTERNAL_PORT=4096

# Session lifecycle
CQL_STUDIO_OPENCODE_SESSION_IDLE_MS=3600000
CQL_STUDIO_OPENCODE_CLEANUP_INTERVAL_MS=60000
CQL_STUDIO_OPENCODE_PROVIDER_STALL_MS=180000

# Host-local runner: keep Ollama localhost URLs as-is. Set to true inside Docker
# so localhost provider URLs rewrite to host.docker.internal.
CQL_STUDIO_OPENCODE_RUNNER_REWRITE_LOCALHOST=false

# Ephemeral session workspaces (created under this directory)
CQL_STUDIO_OPENCODE_WORKSPACE_ROOT=./workspaces

# MarkItDown must be on PATH at startup (PDF/DOCX → Markdown):
#   python3 -m pip install 'markitdown[pdf,docx]==0.1.7'
# CQL_STUDIO_OPENCODE_MCP_BRIDGE_BIN=
