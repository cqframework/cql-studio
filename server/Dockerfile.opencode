FROM node:26-bookworm-slim

LABEL maintainer="Preston Lee"
WORKDIR /app

COPY package.json package-lock.json ./
COPY core/package.json core/tsconfig.json ./core/
COPY core/src ./core/src
COPY server/package.json server/tsconfig.json server/prisma.config.ts ./server/
COPY server/prisma ./server/prisma
COPY server/src ./server/src
COPY ui/package.json ./ui/

RUN npm ci --workspace=@cql-studio/server --workspace=@cql-studio/core --include-workspace-root
RUN npm run build --workspace=@cql-studio/core \
  && npm run build --workspace=@cql-studio/server \
  && npm prune --omit=dev --ignore-scripts --workspace=@cql-studio/server --workspace=@cql-studio/core --include-workspace-root

# MarkItDown converts PDF and DOCX attachments to bounded Markdown before they
# are exposed to the OpenCode session. Keep it in an isolated virtualenv so
# the Node runner remains the only application process.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv \
  && python3 -m venv /opt/markitdown \
  && /opt/markitdown/bin/pip install --no-cache-dir 'markitdown[pdf,docx]==0.1.7' \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/app/node_modules/.bin:${PATH}"
ENV CQL_STUDIO_SERVER_NODE_ENV=development
ENV CQL_STUDIO_SERVER_OPENCODE_RUNNER_PORT=4097
ENV CQL_STUDIO_SERVER_OPENCODE_INTERNAL_PORT=4096
ENV CQL_STUDIO_SERVER_OPENCODE_WORKSPACE_ROOT=/workspaces
ENV CQL_STUDIO_SERVER_MARKITDOWN_BIN=/opt/markitdown/bin/markitdown

RUN mkdir -p /workspaces && chown -R node:node /app /workspaces
USER node
WORKDIR /app/server

EXPOSE 4097
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4097/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "dist/opencode/runner.js"]
