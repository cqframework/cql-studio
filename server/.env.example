# CQL Studio Server Environment Variables (Development Defaults)
CQL_STUDIO_SERVER_PORT=3003
CQL_STUDIO_SERVER_NODE_ENV=development
CQL_STUDIO_SERVER_LOG_LEVEL=info

# CORS & Webapp URLs
CQL_STUDIO_SERVER_CORS_ORIGIN=http://localhost:4200
CQL_STUDIO_SERVER_UI_BASE_URL=http://localhost:4200

# Database (PostgreSQL matching docker/docker-compose.development.yml)
CQL_STUDIO_SERVER_DATABASE_URL=postgresql://cql_studio:password@localhost:5432/cql_studio_development

# SSO / OIDC (Authentik matching docker/docker-compose.development.yml)
CQL_STUDIO_SERVER_SSO_ISSUER_URL=http://localhost:9000/application/o/cql-studio/
CQL_STUDIO_SERVER_SSO_CLIENT_ID=cql-studio-development
CQL_STUDIO_SERVER_SSO_CLIENT_SECRET=cql-studio-development-secret
CQL_STUDIO_SERVER_SSO_REDIRECT_URL=http://localhost:3003/api/auth/callback
CQL_STUDIO_SERVER_SSO_SCOPES=openid profile email
CQL_STUDIO_SERVER_SESSION_SECRET=cql-studio-development-session-secret
